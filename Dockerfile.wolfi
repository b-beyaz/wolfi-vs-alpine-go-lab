FROM cgr.dev/chainguard/go:latest AS build
WORKDIR /src
COPY go.mod main.go ./
ARG VERSION=dev
ARG COMMIT=none
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/app .

FROM cgr.dev/chainguard/static:latest
COPY --from=build /out/app /app
USER 65532
EXPOSE 8080
ENTRYPOINT ["/app"]
